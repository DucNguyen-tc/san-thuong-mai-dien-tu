generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enum cũ — KHÔNG SỬA, dùng cho bảng recommendation_logs
enum RecommendationEventType {
  IMPRESSION
  CLICK
  PURCHASE
}

// Enum mới cho hành vi người dùng (user_product_events)
enum UserEventType {
  VIEW
  ADD_TO_CART
}

model ProductVector {
  product_id  String                     @id @db.Uuid
  embedding   Unsupported("vector(500)")
  computed_at DateTime                   @default(now()) @db.Timestamptz

  @@map("product_vectors")
}

model RecommendationLog {
  id                     BigInt                  @id @default(autoincrement())
  source_product_id      String                  @db.Uuid
  recommended_product_id String                  @db.Uuid
  customer_id            String?                 @db.Uuid
  event_type             RecommendationEventType
  similarity_score       Float?                  @db.DoublePrecision
  created_at             DateTime                @default(now()) @db.Timestamptz

  @@index([created_at])
  @@map("recommendation_logs")
}

// Bảng mới: ghi hành vi người dùng để xây user vector cá nhân hóa
// Không đụng bảng recommendation_logs cũ
model UserProductEvent {
  id          BigInt        @id @default(autoincrement())
  customer_id String        @db.Uuid
  product_id  String        @db.Uuid
  event_type  UserEventType
  created_at  DateTime      @default(now()) @db.Timestamptz

  @@index([customer_id, created_at])
  @@map("user_product_events")
}
