PORT=3004
NODE_ENV=development
DATABASE_URL="postgresql://admin:1234567@localhost:5432/order_db?schema=public"
CATALOG_SERVICE_URL=http://localhost:3002
CART_SERVICE_URL=http://localhost:3003
PAYMENT_SERVICE_URL=http://localhost:3005
IDENTITY_SERVICE_URL=http://localhost:3001
RABBITMQ_URL="amqp://guest:guest@localhost:5672"

# --- CẤU HÌNH TELEGRAM BOT VẬN HÀNH & BÁO CÁO KINH DOANH ---
# 1. Tạo bot qua @BotFather trên Telegram để nhận Token
TELEGRAM_BOT_TOKEN="your_bot_token_here"

# 2. Chat ID của Admin (Gửi lệnh /start cho bot hoặc qua @userinfobot để lấy ID)
TELEGRAM_CHAT_ID="your_chat_id_here"

# 3. Whitelist các Chat ID được phép tương tác ra lệnh cho bot (phân tách bởi dấu phẩy)
TELEGRAM_WHITELIST_CHATS="your_chat_id_here"

# 4. Lịch gửi báo cáo tự động (Mặc định: 23:00 đêm hàng ngày)
TELEGRAM_REPORT_CRON="0 23 * * *"
